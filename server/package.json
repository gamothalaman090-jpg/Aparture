{
  "name": "camera-rental-server",
  "version": "1.0.0",
  "description": "Backend server for Camera Rental E-Commerce Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "dev": "nodemon --exec \"node --dns-result-order=ipv4first\" server.js",
    "seed": "node --dns-result-order=ipv4first seed/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
